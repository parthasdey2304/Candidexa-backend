# =============================================================================
# Candidexa Backend — PRODUCTION ENV for Railway & Render
# Supabase project: lpgtdyktniumthilrsnc
# Copy these as VARIABLES in Railway Dashboard & Render Dashboard — DO NOT commit
# =============================================================================

# --- App (MUST be production, no localhost in CORS) ---
ENVIRONMENT=production
APP_NAME=Candidexa Backend
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Database (POOLER, port 6543, sslmode=require, psycopg) ---
# HOW TO GET:
# Supabase Dashboard -> lpgtdyktniumthilrsnc -> Database -> Connect -> Transaction pooling (6543)
# Copy string, replace [YOUR_DB_PASSWORD] with your DB password, keep ?sslmode=require
# Example: postgresql://postgres.lpgtdyktniumthilrsnc:YOUR_PASS@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# App auto-normalizes postgresql:// -> postgresql+psycopg://
DATABASE_URL=postgresql://postgres.lpgtdyktniumthilrsnc:[YOUR_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Supabase (new project) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_JWT_KID=your_supabase_jwt_kid_here
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_API_URL=https://YOUR_PROJECT.supabase.co/rest/v1/

# --- JWT & Auth (HS256, >=32 chars, never replace_me) ---
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth (set real client ID from console.cloud.google.com, else /oauth/google returns 503) ---
GOOGLE_CLIENT_ID=replace_me

# --- AI Providers (server-only, never expose to frontend) ---
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=replace_me
MISTRAL_MODEL=mistral-small

# --- Redis (Railway: add Redis plugin -> use private URL; Render: use Upstash Redis) ---
# Railway private example: redis://default:password@redis.railway.internal:6379/0
# Render/Upstash example: rediss://default:password@us1-xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# --- CORS (PRODUCTION: NO localhost, NO *, exact origins only — see app/core/config.py:92) ---
FRONTEND_ORIGINS=https://candidexa.vercel.app,https://candidexa.online

# --- AI Guardrails ---
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=50
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=20000
AI_DAILY_TOKEN_LIMIT=10000
AI_MONTHLY_TOKEN_LIMIT=100000
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=2000

# --- Upload Limits ---
MAX_RESUME_SIZE_MB=10
MAX_JSON_BODY_MB=1

# --- Field-level Encryption (AES-256-GCM + HMAC) ---
# 32 bytes base64 each, MUST differ — rotate every 90 days
FIELD_ENCRYPTION_KEY=your_32_byte_base64_key_here
FIELD_BLIND_INDEX_KEY=your_different_32_byte_base64_key_here
