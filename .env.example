# Environment
ENVIRONMENT=development
APP_NAME=Candidexa Backend
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# JWT & Authentication
JWT_SECRET=replace_with_a_long_random_development_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=replace_me

# AI Providers (server-side only)
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=replace_me
MISTRAL_MODEL=mistral-small

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379/0

# Frontend CORS
FRONTEND_ORIGINS=http://localhost:3000

# AI Guardrails
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=50
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=20000
AI_DAILY_TOKEN_LIMIT=10000
AI_MONTHLY_TOKEN_LIMIT=100000

# File Upload Limits
MAX_RESUME_SIZE_MB=10
MAX_JSON_BODY_MB=1

# Field-level Encryption (AES-256-GCM + HMAC blind index)
# Generate with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
FIELD_ENCRYPTION_KEY=replace_with_base64_32_bytes
FIELD_BLIND_INDEX_KEY=replace_with_different_base64_32_bytes